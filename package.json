{
  "name": "@figma/expressive-components",
  "version": "0.2.0",
  "description": "React components for WebGPU shader fills and effects on DOM content.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figma/expressive-components.git"
  },
  "homepage": "https://github.com/figma/expressive-components#readme",
  "bugs": {
    "url": "https://github.com/figma/expressive-components/issues"
  },
  "keywords": [
    "react",
    "webgpu",
    "shaders",
    "effects",
    "figma"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./source": {
      "types": "./dist/source.generated.d.ts",
      "import": "./dist/source.generated.js"
    }
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true }); rmSync('src/source.generated.ts', { force: true })\"",
    "build": "npm run clean && node gen-source.js && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "dev": "vite --config examples/vite.config.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "build:examples": "vite build --config examples/vite.config.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.72",
    "eslint": "^10.10.0",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.4.2"
  }
}
